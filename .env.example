# Docker Compose 可选配置
MYSQL_DATABASE=office_tools
MYSQL_USER=office_tools
MYSQL_PASSWORD=office_tools_dev
MYSQL_ROOT_PASSWORD=office_tools_root_dev
DATABASE_URL=mysql+pymysql://office_tools:office_tools_dev@mysql:3306/office_tools?charset=utf8mb4
JWT_SECRET=development-only-change-this-secret-32
JWT_EXPIRE_MINUTES=720
RATE_LIMIT_PER_MINUTE=60
EXCEL_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=

# 默认关闭。填写后仅在未处理的 500 错误时发送通用 JSON Webhook
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=3
ALERT_COOLDOWN_SECONDS=60
