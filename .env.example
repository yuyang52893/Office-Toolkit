# Docker Compose 必填配置
MYSQL_DATABASE=office_tools
MYSQL_USER=office_tools
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
DATABASE_URL=mysql+pymysql://office_tools:replace-with-a-strong-password@mysql:3306/office_tools?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720
RATE_LIMIT_PER_MINUTE=60
EXCEL_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=

# 默认关闭。填写后仅在未处理的 500 错误时发送通用 JSON Webhook
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=3
ALERT_COOLDOWN_SECONDS=60
